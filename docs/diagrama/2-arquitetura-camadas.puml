@startuml arquitetura-camadas
' Diagrama de classes 2/2 - Arquitetura em 3 camadas (RA3)
' Gerar: plantuml -tsvg docs/diagrama/*.puml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam classFontSize 12
skinparam classFontStyle bold
skinparam packageStyle rectangle
skinparam nodesep 30
skinparam ranksep 45
hide circle
hide empty members
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #333333
  ArrowColor #555555
  StereotypeFontSize 10
}
skinparam package {
  FontSize 13
  BorderColor #555555
}
skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #999999
  FontSize 10
}

title Clínica Psico (RA3) - Diagrama de classes 2/2: arquitetura em 3 camadas

' =====================================================================
package "APRESENTAÇÃO  (consultas.app, consultas.app.cadastro)" as apresentacao #F3F7FC {

  class Main {
    + {static} main(args : String[]) : void
  }

  class MenuConsole {
    + iniciar() : void
  }

  class DadosExemplo {
    + {static} carregarSeVazio() : void
  }

  class Console <<utilitária>> {
    + {static} lerNumero(...) : int
    + {static} lerTexto(...) : String
    + {static} lerData(...) : LocalDate
    + {static} escolher(...) : T
    + {static} confirmar(...) : boolean
  }

  class MenuCadastros {
    + exibir() : void
  }

  abstract class "MenuCrud<T, D extends GenericDAO<T>>" as MenuCrud {
    # dao : D
    + exibir() : void {final}
    # {abstract} cadastrar() : void
    # {abstract} editar(entidade : T) : boolean
    # detalhar(entidade : T) : void
    # listar() : void
    # buscar() : void
    # atualizar() : void
    # excluir() : void
  }

  class MenuPaciente
  class MenuPsicologo
  class MenuPessoa
  class MenuClinica
  class MenuEspecialidade
  class MenuHorario
  class MenuConsulta
  class MenuNotificacao
}

' =====================================================================
package "NEGÓCIO  (padrões do RA2)" as negocio #F5FAF3 {

  class AgendamentoFacade <<Facade>> {
    + listarHorarios(c, p, estrategia) : List<HorarioAtendimento>
    + agendar(paciente, horario) : Consulta
    + cancelar(consulta) : Consulta
  }

  class Agenda {
    + listarDisponiveis(clinica, psicologo) : List<HorarioAtendimento>
    + atualizar(horario) : HorarioAtendimento
  }

  abstract class ValidadorAgendamento <<Chain>> {
    + setProximo(v) : ValidadorAgendamento
    + validar(paciente, horario) : void {final}
    # {abstract} verificar(paciente, horario) : void
  }
  class ValidadorVinculo
  class ValidadorDataFutura
  class ValidadorDisponibilidade
  class ValidadorConflitoPaciente

  interface EstrategiaOrdenacao <<Strategy>> {
    + ordenar(horarios) : List<HorarioAtendimento>
    + getDescricao() : String
  }
  class OrdemCronologica
  class PreferenciaTurno
  enum Turno <<enumeration>> {
    MANHA
    TARDE
    NOITE
  }

  class PublicadorAgendamento <<Observer>> {
    + inscrever(o) : void
    + remover(o) : void
    + notificar(consulta) : void
    + notificarCancelamento(consulta) : void
  }
  interface ObservadorAgendamento {
    + aoAgendar(consulta) : void
    + aoCancelar(consulta) : void
  }
  class NotificadorPaciente
}

' =====================================================================
package "DADOS  (consultas.dao + JPA / EclipseLink)" as dados #FDF6EC {

  class JPAUtil <<utilitária>> {
    - {static} fabrica : EntityManagerFactory
    + {static} getEntityManager() : EntityManager
    + {static} emTransacao(trabalho) : R
    + {static} consultar(consulta) : R
    + {static} fechar() : void
  }

  class "GenericDAO<T>" as GenericDAO {
    # classe : Class<T>
    + salvar(entidade : T) : T
    + buscarPorId(id : Long) : T
    + listarTodos() : List<T>
    + atualizar(entidade : T) : T
    + remover(id : Long) : boolean
    # existeOutro(atributo, valor, ignorarId) : boolean
    # {static} impedirSeExistir(jpql, id, mensagem) : void
  }

  class PacienteDAO
  class PsicologoDAO
  class ClinicaDAO
  class EspecialidadeDAO
  class HorarioDAO
  class ConsultaDAO {
    + registrar(paciente, horario) : Consulta
    + cancelar(id : Long) : Consulta
  }
  class NotificacaoDAO
}

' =====================================================================
class "consultas.modelo" as modelo <<camada de modelo - detalhada na página 1>> #F4F4F4 {
  Pessoa [abstrata], Paciente, Psicologo
  Clinica, Especialidade, HorarioAtendimento
  Consulta, Notificacao
  StatusConsulta, TipoNotificacao
  AgendamentoException
}

' ---------- Apresentação ----------
Main ..> DadosExemplo : 1. carga inicial
Main ..> MenuConsole : 2. abre o menu
MenuConsole --> AgendamentoFacade
MenuConsole --> MenuCadastros
MenuCadastros o-- "8" MenuCrud
MenuCrud <|-- MenuPaciente
MenuCrud <|-- MenuPsicologo
MenuCrud <|-- MenuPessoa
MenuCrud <|-- MenuClinica
MenuCrud <|-- MenuEspecialidade
MenuCrud <|-- MenuHorario
MenuCrud <|-- MenuConsulta
MenuCrud <|-- MenuNotificacao
MenuConsulta --> AgendamentoFacade : agendar / cancelar

' ---------- Negócio ----------
AgendamentoFacade --> Agenda
AgendamentoFacade --> ValidadorAgendamento
AgendamentoFacade --> PublicadorAgendamento
AgendamentoFacade ..> EstrategiaOrdenacao
ValidadorAgendamento --> "0..1 proximo" ValidadorAgendamento
ValidadorAgendamento <|-- ValidadorVinculo
ValidadorAgendamento <|-- ValidadorDataFutura
ValidadorAgendamento <|-- ValidadorDisponibilidade
ValidadorAgendamento <|-- ValidadorConflitoPaciente
EstrategiaOrdenacao <|.. OrdemCronologica
EstrategiaOrdenacao <|.. PreferenciaTurno
PreferenciaTurno --> Turno
PublicadorAgendamento o-- "0..*" ObservadorAgendamento
ObservadorAgendamento <|.. NotificadorPaciente

' ---------- Dados ----------
GenericDAO <|-- PacienteDAO
GenericDAO <|-- PsicologoDAO
GenericDAO <|-- ClinicaDAO
GenericDAO <|-- EspecialidadeDAO
GenericDAO <|-- HorarioDAO
GenericDAO <|-- ConsultaDAO
GenericDAO <|-- NotificacaoDAO
GenericDAO ..> JPAUtil

' ---------- Entre camadas ----------
' (as setas de pacote resumem dependências de várias classes)
apresentacao ..> dados : menus de CRUD usam\no DAO da entidade (dao : D)
negocio ..> dados : Facade, Agenda, Validador e\nNotificador usam os DAOs
GenericDAO ..> modelo : persiste via EntityManager

note left of MenuCrud
  <b>Template Method</b>: listar, buscar,
  atualizar e excluir são comuns;
  cada menu implementa cadastrar,
  detalhar e editar.
  Ex.: MenuClinica extends
  MenuCrud<Clinica, ClinicaDAO>
end note

legend right
  <b>Leitura</b>: cada camada só depende das de baixo.
  Apresentação → Negócio → Dados → Modelo
  Os DAOs específicos acrescentam consultas JPQL
  e as regras de exclusão (sobrescrevendo remover).
  As entidades (Modelo) estão detalhadas na página 1.
endlegend

@enduml
