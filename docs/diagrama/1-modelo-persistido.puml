@startuml modelo-persistido
' Diagrama de classes 1/2 - Modelo de domínio persistido (RA3)
' Gerar: plantuml -tsvg docs/diagrama/*.puml

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam classFontSize 13
skinparam classFontStyle bold
skinparam packageStyle rectangle
skinparam nodesep 60
skinparam ranksep 80
hide circle
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #333333
  ArrowColor #333333
  StereotypeFontSize 10
}
skinparam enum {
  BackgroundColor #F4F4F4
  BorderColor #333333
}
skinparam note {
  BackgroundColor #FFFDE7
  BorderColor #999999
  FontSize 11
}
hide empty members

title Clínica Psico (RA3) - Diagrama de classes 1/2: modelo de domínio persistido (JPA + EclipseLink)

package "consultas.modelo" {

  abstract class Pessoa <<entity>> {
    .. tabela: pessoa (herança JOINED) ..
    - id : Long
    - nome : String
    - email : String
    - telefone : String
  }

  class Paciente <<entity>> {
    .. tabela: paciente ..
    - cpf : String {unique}
    - dataNascimento : LocalDate
  }

  class Psicologo <<entity>> {
    .. tabela: psicologo ..
    - crp : String {unique}
    --
    + vincular(clinica : Clinica) : void
    + desvincular(clinica : Clinica) : void
    + atendeEm(clinica : Clinica) : boolean
    + adicionarEspecialidade(e : Especialidade) : void
    + removerEspecialidade(e : Especialidade) : void
  }

  class Clinica <<entity>> {
    .. tabela: clinica ..
    - id : Long
    - nome : String
    - endereco : String
    - telefone : String
  }

  class Especialidade <<entity>> {
    .. tabela: especialidade ..
    - id : Long
    - nome : String {unique}
    - descricao : String
  }

  class HorarioAtendimento <<entity>> {
    .. tabela: horario_atendimento ..
    + {static} DURACAO_MINUTOS : int = 50
    - id : Long
    - inicio : LocalDateTime
    - reservado : boolean
    --
    + reservar() : void
    + liberar() : void
  }

  class Consulta <<entity>> {
    .. tabela: consulta ..
    - id : Long
    - status : StatusConsulta
    - dataRegistro : LocalDateTime
    - observacoes : String
    --
    + cancelar() : void
    + marcarRealizada() : void
    + isAtiva() : boolean
  }

  class Notificacao <<entity>> {
    .. tabela: notificacao ..
    - id : Long
    - tipo : TipoNotificacao
    - mensagem : String
    - dataHora : LocalDateTime
    - lida : boolean
    --
    + marcarComoLida() : void
  }

  enum StatusConsulta <<enumeration>> {
    AGENDADA
    CANCELADA
    REALIZADA
  }

  enum TipoNotificacao <<enumeration>> {
    CONFIRMACAO
    CANCELAMENTO
  }
}

' ---------- Herança ----------
Pessoa <|-- Paciente
Pessoa <|-- Psicologo

' ---------- N:N (tabelas de junção) ----------
Psicologo "0..*" -- "0..*" Clinica : atende em\n(psicologo_clinica)
Psicologo "0..*" -- "0..*" Especialidade : possui\n(psicologo_especialidade)

' ---------- N:1 / 1:N ----------
Psicologo "1" -- "0..*" HorarioAtendimento : disponibiliza
Clinica "1" -- "0..*" HorarioAtendimento : sedia
Paciente "1" -- "0..*" Consulta : agenda
Consulta "0..*" --> "1" HorarioAtendimento : ocupa

' ---------- Composição (cascade + orphanRemoval) ----------
Consulta "1" *-- "0..*" Notificacao : gera

' ---------- Enums ----------
Consulta ..> StatusConsulta
Notificacao ..> TipoNotificacao

note left of Consulta
  Consulta → Horário é N:1 (e não 1:1):
  a consulta cancelada fica no histórico
  e o horário pode receber outra consulta.
  No máximo uma AGENDADA por horário
  (garantido pela Chain).
end note

legend right
  <b>Notação</b>
  + público   - privado   # protegido   ~ pacote
  <u>sublinhado</u> = estático     <i>itálico</i> = abstrato
  {unique} = coluna com restrição UNIQUE
  ◆ composição: notificações são apagadas com a consulta
  Omitidos: getters, setters, construtores, equals/hashCode (pelo id) e toString.
  Toda entidade: @Id @GeneratedValue(IDENTITY) e construtor vazio protegido.
endlegend

@enduml
